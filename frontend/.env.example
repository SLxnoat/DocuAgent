# DocuAgent AI — Frontend Environment Variables
# Copy to .env for local development

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_HOST=localhost:8000

# ⚠️ Security: This token is baked into the public JS bundle.
# v2 TODO: Replace with backend-for-frontend session cookie auth.
VITE_API_TOKEN=dev-secret-token-change-in-production

# Feature Flags
VITE_ENABLE_PDF_EXPORT=true
VITE_ENABLE_WEBSOCKET_CHAT=true
VITE_MAX_SCRIPT_LENGTH=10000

# UI Configuration
VITE_EDITOR_THEME=vs-dark
VITE_DEFAULT_LANGUAGE=en
