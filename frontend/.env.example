# ==============================================================================
# DocuAgent AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local before running the development server.
# ==============================================================================

# API Base URL (FastAPI Backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket Base URL
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# App Configuration
VITE_APP_TITLE=DocuAgent AI
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_DARK_MODE=true
