# ==============================================================================
# DocuAgent AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend application.
# Do NOT commit .env files containing production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME=DocuAgent AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-in-production
API_TOKEN=dev-secret-token-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Redis Configuration (State Checkpointer & Task Broker)
# ------------------------------------------------------------------------------
# Database 0: LangGraph state checkpoints
# Database 1: Celery task queue broker
# Database 2: Celery task result backend
# Database 3: SSE Pub/Sub event streaming
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_HOURS=24
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_PUBSUB_URL=redis://localhost:6379/3

# ------------------------------------------------------------------------------
# 3. Ollama Cloud LLM Inference Configuration
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_API_KEY=your-ollama-cloud-api-key-here
OLLAMA_PRIMARY_MODEL=llama3.3:70b
OLLAMA_ANALYZER_MODEL=qwen2.5:72b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 4. Playwright Browser Automation Engine
# ------------------------------------------------------------------------------
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_SELECTOR_TIMEOUT_MS=10000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_RETRIES=2
PLAYWRIGHT_HIGHLIGHT_COLOR=#06b6d4
PLAYWRIGHT_HIGHLIGHT_OPACITY=0.15

# ------------------------------------------------------------------------------
# 5. Media & Storage Paths
# ------------------------------------------------------------------------------
ASSETS_DIR=../assets
EXPORTS_DIR=../exports
ASSET_RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# 6. Document Export Subsystems
# ------------------------------------------------------------------------------
WEASYPRINT_ENABLED=true
PANDOC_ENABLED=true

# ------------------------------------------------------------------------------
# 7. Celery Worker Concurrency & Safety
# ------------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=5
CELERY_TASK_TIMEOUT_SECONDS=600
CELERY_MAX_TASKS_PER_CHILD=50
