# ==============================================================================
# DocuAgent AI — Production Celery Worker Dockerfile
# Executes multi-agent state machines, screenshot captures, and document export
# ==============================================================================

FROM python:3.11-slim-bookworm AS runtime

# System environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    C_FORCE_ROOT=0

WORKDIR /app

# Configure apt retries and install only runtime PDF/document rendering libraries
RUN echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    shared-mime-info \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libcairo2 \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

# Install Python production dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Install Playwright browser engine & required system dependencies
RUN mkdir -p /ms-playwright && \
    playwright install --with-deps chromium

# Create storage volume directories
RUN mkdir -p /app/assets /app/exports

# Create non-root application user for secure task execution
RUN groupadd -g 1001 docuagent && \
    useradd -u 1001 -g docuagent -s /bin/bash -m docuagent

# Copy application source tree
COPY . /app

# Configure ownership and permissions
RUN chown -R docuagent:docuagent /app /ms-playwright && \
    chmod -R 755 /app/assets /app/exports

USER docuagent

# Start Celery worker targeting generation, capture, export, and maintenance queues
CMD ["celery", "-A", "app.celery", "worker", "--loglevel=info", "--concurrency=2", "-Q", "generation,capture,export,maintenance,default"]
